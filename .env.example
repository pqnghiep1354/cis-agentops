# ============================================================
#  CIS AgentOps — Environment Configuration
#  Copy to .env and fill in your credentials
#  NEVER commit .env to git
# ============================================================

# ── LLM Keys (REQUIRED) ─────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-...

# ── DataForSEO (REQUIRED for real SEO — set MOCK_SEO=false) ─
DATAFORSEO_LOGIN=your@email.com
DATAFORSEO_PASSWORD=your_dataforseo_password
MOCK_SEO=false

# ── Langfuse (Personal Cloud) ────────────────────────────────
# Get from: https://cloud.langfuse.com → Settings → API Keys
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# ── PostgreSQL (Docker Compose default) ──────────────────────
DATABASE_URL=postgresql://cis:cis_local_pass@localhost:5432/cis_local

# ── ChromaDB (Docker Compose default) ───────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ── Pipeline Behaviour ───────────────────────────────────────
# Set true to auto-approve HITL (useful for notebook demo)
AUTO_APPROVE_HITL=false
